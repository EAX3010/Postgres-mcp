{
  "Databases": {
    "production": "Host=localhost;Port=5432;Database=mydb;Username=postgres;Password=YOUR_PASSWORD_HERE",
    "development": "Host=localhost;Port=5432;Database=devdb;Username=postgres;Password=YOUR_PASSWORD_HERE"
  },
  "Safety": {
    "RequireConfirmation": true,
    "EnableDryRun": true,
    "CriticalOperations": ["DROP", "TRUNCATE", "DELETE", "ALTER", "GRANT", "REVOKE"]
  },
  "Audit": {
    "Enabled": true,
    "LogPath": "audit.log",
    "LogToConsole": false
  }
}
