<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>PostgresMcpServer</AssemblyName>
    <RootNamespace>PostgresMcpServer</RootNamespace>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <Version>1.0.0</Version>
    <Description>A Model Context Protocol server for PostgreSQL.</Description>
  </PropertyGroup>

  <!-- The test projects live under tests/ and must not be compiled into the server. -->
  <ItemGroup>
    <Compile Remove="tests/**" />
    <None Remove="tests/**" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="PostgresMcpServer.Tests" />
    <InternalsVisibleTo Include="PostgresMcpServer.IntegrationTests" />
  </ItemGroup>

  <!--
    Everything a user needs travels with the executable, so a downloaded release archive is
    self-sufficient: the settings template, and a ready-to-copy config per MCP client.
    appsettings.json itself is only copied when the developer has created one locally.
  -->
  <ItemGroup>
    <None Update="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="appsettings.example.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="examples/*.json" Link="examples/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="LICENSE" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="10.0.11" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.11" />
    <PackageReference Include="ModelContextProtocol" Version="2.2.0" />
    <PackageReference Include="Npgsql" Version="10.0.3" />
  </ItemGroup>

</Project>
